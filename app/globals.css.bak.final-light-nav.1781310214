@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}


/* ------------------------------------------------------------------
   CRPM Simulations - final light-mode contrast fix
   Scope: explicit light theme only. Dark mode untouched.
------------------------------------------------------------------ */

[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard"],
[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/portfolio"],
[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/watchlist"],
[data-crpm-theme="light"] .crpm-simulations-page [href="/simulatore-pro"],
[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/simulations"],
html[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard"],
html[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/portfolio"],
html[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/watchlist"],
html[data-crpm-theme="light"] .crpm-simulations-page [href="/simulatore-pro"],
html[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/simulations"],
body[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard"],
body[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/portfolio"],
body[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/watchlist"],
body[data-crpm-theme="light"] .crpm-simulations-page [href="/simulatore-pro"],
body[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/simulations"] {
  color: #0f172a !important;
  background: #ffffff !important;
  border-color: #94a3b8 !important;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08) !important;
}

[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard"]:hover,
[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/portfolio"]:hover,
[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/watchlist"]:hover,
[data-crpm-theme="light"] .crpm-simulations-page [href="/simulatore-pro"]:hover,
[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/simulations"]:hover,
html[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard"]:hover,
html[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/portfolio"]:hover,
html[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/watchlist"]:hover,
html[data-crpm-theme="light"] .crpm-simulations-page [href="/simulatore-pro"]:hover,
html[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/simulations"]:hover,
body[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard"]:hover,
body[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/portfolio"]:hover,
body[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/watchlist"]:hover,
body[data-crpm-theme="light"] .crpm-simulations-page [href="/simulatore-pro"]:hover,
body[data-crpm-theme="light"] .crpm-simulations-page [href="/dashboard/simulations"]:hover {
  color: #075985 !important;
  background: #e0f2fe !important;
  border-color: #0284c7 !important;
}

[data-crpm-theme="light"] .crpm-simulations-page a[href*="machine="],
html[data-crpm-theme="light"] .crpm-simulations-page a[href*="machine="],
body[data-crpm-theme="light"] .crpm-simulations-page a[href*="machine="] {
  color: #075985 !important;
  background: #e0f2fe !important;
  border-color: #0284c7 !important;
  font-weight: 900 !important;
}

