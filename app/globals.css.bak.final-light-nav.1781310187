@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}


/* ------------------------------------------------------------------
   CRPM Simulations - scoped Light Mode readability fix
   Applies only when an explicit light theme marker exists.
   Does not affect Dark Mode.
------------------------------------------------------------------ */

html.light .crpm-simulations-page,
body.light .crpm-simulations-page,
[data-theme="light"] .crpm-simulations-page,
[data-mode="light"] .crpm-simulations-page,
.crpm-simulations-page.light {
  --crpm-heading: #020617;
  --crpm-text: #0f172a;
  --crpm-muted: #334155;
  --crpm-faint: #64748b;
  --crpm-border: #cbd5e1;
  --crpm-panel: #ffffff;
  --crpm-panel-2: #f8fafc;
  --crpm-cell: #f1f5f9;
  --crpm-soft: rgba(14, 165, 233, 0.10);
  --crpm-blue: #0284c7;
}

html.light .crpm-simulations-page a[href*="machine="],
body.light .crpm-simulations-page a[href*="machine="],
[data-theme="light"] .crpm-simulations-page a[href*="machine="],
[data-mode="light"] .crpm-simulations-page a[href*="machine="],
.crpm-simulations-page.light a[href*="machine="] {
  background: #e0f2fe;
  border-color: #0284c7;
  color: #075985;
  font-weight: 900;
}

html.light .crpm-simulations-page .text-white,
html.light .crpm-simulations-page .text-slate-50,
html.light .crpm-simulations-page .text-zinc-50,
html.light .crpm-simulations-page .text-neutral-50,
body.light .crpm-simulations-page .text-white,
body.light .crpm-simulations-page .text-slate-50,
body.light .crpm-simulations-page .text-zinc-50,
body.light .crpm-simulations-page .text-neutral-50,
[data-theme="light"] .crpm-simulations-page .text-white,
[data-theme="light"] .crpm-simulations-page .text-slate-50,
[data-theme="light"] .crpm-simulations-page .text-zinc-50,
[data-theme="light"] .crpm-simulations-page .text-neutral-50,
[data-mode="light"] .crpm-simulations-page .text-white,
[data-mode="light"] .crpm-simulations-page .text-slate-50,
[data-mode="light"] .crpm-simulations-page .text-zinc-50,
[data-mode="light"] .crpm-simulations-page .text-neutral-50,
.crpm-simulations-page.light .text-white,
.crpm-simulations-page.light .text-slate-50,
.crpm-simulations-page.light .text-zinc-50,
.crpm-simulations-page.light .text-neutral-50 {
  color: #020617 !important;
}

html.light .crpm-simulations-page .text-slate-300,
html.light .crpm-simulations-page .text-zinc-300,
html.light .crpm-simulations-page .text-neutral-300,
body.light .crpm-simulations-page .text-slate-300,
body.light .crpm-simulations-page .text-zinc-300,
body.light .crpm-simulations-page .text-neutral-300,
[data-theme="light"] .crpm-simulations-page .text-slate-300,
[data-theme="light"] .crpm-simulations-page .text-zinc-300,
[data-theme="light"] .crpm-simulations-page .text-neutral-300,
[data-mode="light"] .crpm-simulations-page .text-slate-300,
[data-mode="light"] .crpm-simulations-page .text-zinc-300,
[data-mode="light"] .crpm-simulations-page .text-neutral-300,
.crpm-simulations-page.light .text-slate-300,
.crpm-simulations-page.light .text-zinc-300,
.crpm-simulations-page.light .text-neutral-300 {
  color: #475569 !important;
}

